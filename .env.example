NODE_ENV=development
PORT=3003

# Base de données PostgreSQL dédiée à ce service (aucune base partagée avec les autres microservices)
DATABASE_URL=postgresql://livraison:livraison@livraison-db:5432/livraison

# RabbitMQ tourne dans le repo goodfood-infra, à lancer avant ce service
RABBITMQ_URL=amqp://goodfood:changeme@rabbitmq:5672

# Secret partagé avec le service Auth pour la vérification des JWT (HS256)
JWT_SECRET=changeme_shared_secret

# Géocodage (Nominatim / OpenStreetMap, sans clé API)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=goodfood-livraison-dev (contact@example.com)

# Règles métier configurables
AVERAGE_COURIER_SPEED_KMH=20
DEFAULT_SEARCH_RADIUS_KM=5
MAX_SEARCH_RADIUS_KM=50
MAX_ACTIVE_DELIVERIES_PER_COURIER=3
